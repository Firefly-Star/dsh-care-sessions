{
  "name": "dsh-care-sessions",
  "version": "0.1.0",
  "description": "A draggable care list of hand-picked sessions across workspaces in the DSH web UI: star a session in the sidebar, then jump to it from a floating card (or from the star that lives in the Workspace header row)",
  "type": "module",
  "main": "index.js",
  "icon": "assets/plugin-icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/plugin-icon.svg",
    "install.ps1",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sessions",
    "favorites",
    "bookmarks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Firefly-Star/dsh-care-sessions.git"
  },
  "homepage": "https://github.com/Firefly-Star/dsh-care-sessions#readme",
  "bugs": {
    "url": "https://github.com/Firefly-Star/dsh-care-sessions/issues"
  },
  "author": "Firefly-Star"
}
